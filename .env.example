# DailyPicks 环境变量模板 —— 复制为 .env 并填入真实值
# DeepSeek API Key（必填）：https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=

# 推送渠道二选一：
# 企业微信机器人 webhook key（推荐）：群 → 添加群机器人 → 复制 key 部分
WECOM_WEBHOOK_KEY=
# 或 Server酱 SendKey：https://sct.ftqq.com 获取
SERVERCHAN_SENDKEY=

# 点击追踪 API token（tracking 启用时必填）：与 Worker 侧 API_TOKEN 保持一致
TRACKING_API_TOKEN=
